# Copia este archivo y renómbralo a .env
# Rellena los datos según tu PostgreSQL local

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DATABASE=servihogar

# Clave usada para proteger las sesiones de inicio de sesión.
# Pon cualquier texto largo e inventado.
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
